{
  "name": "hiterm",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "💻 An easy-to-use, aesthetically pleasing, and versatile shell management app",
  "author": {
    "name": "Guzyeah Studio",
    "email": "guzyeah@foxmail.com",
    "url": "https://www.guzyeah.cn"
  },
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "tsc && vite build --config vite.config.prod.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --config vite.config.prod.ts",
    "dist": "pnpm build && node scripts/dist.mjs --platform=win --arch=x64",
    "dist:win-x64": "pnpm build && node scripts/dist.mjs --platform=win --arch=x64",
    "dist:win-x86": "pnpm build && node scripts/dist.mjs --platform=win --arch=x86",
    "dist:win-arm64": "pnpm build && node scripts/dist.mjs --platform=win --arch=arm64",
    "dist:linux-x64": "pnpm build && node scripts/dist.mjs --platform=linux --arch=x64",
    "dist:linux-arm64": "pnpm build && node scripts/dist.mjs --platform=linux --arch=arm64",
    "dist:mac-x64": "pnpm build && node scripts/dist.mjs --platform=mac --arch=x64",
    "dist:mac-applesilicon": "pnpm build && node scripts/dist.mjs --platform=mac --arch=applesilicon",
    "dist:win": "pnpm build && node scripts/dist.mjs --platform=win --arch=x64 && node scripts/dist.mjs --platform=win --arch=x86 && node scripts/dist.mjs --platform=win --arch=arm64",
    "dist:linux": "pnpm build && node scripts/dist.mjs --platform=linux --arch=x64 && node scripts/dist.mjs --platform=linux --arch=arm64",
    "dist:mac": "pnpm build && node scripts/dist.mjs --platform=mac --arch=x64 && node scripts/dist.mjs --platform=mac --arch=applesilicon",
    "dist:all": "pnpm dist:win && pnpm dist:linux && pnpm dist:mac"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.326",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^11.0.2",
    "i18next": "^26.1.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "terser": "^5.47.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
